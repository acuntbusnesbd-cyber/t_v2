rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common primitives & helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Task Validation Blueprint
    function isValidTask(data) {
      return data.keys().hasAll(['title', 'priority', 'status', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'priority', 'status', 'dueDate', 'userId', 'createdAt', 'updatedAt', 'isCompleted'])
        && data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && data.priority in ['low', 'medium', 'high']
        && data.status in ['pending', 'in_progress', 'completed']
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 100))
        && (!('isCompleted' in data) || data.isCompleted is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User Profile Validation Blueprint
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'email', 'theme', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && data.email is string && data.email.size() <= 150
        && (!('theme' in data) || data.theme in ['light', 'dark'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Task collection security
    match /tasks/{taskId} {
      // Secure list query enforcement
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Secure single document read
      allow get: if isSignedIn() && isValidId(taskId) && resource.data.userId == request.auth.uid;

      // Secure creation with identity and timestamp integrity
      allow create: if isSignedIn()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      // Secure action-based updates with immutability guarantees
      allow update: if isSignedIn()
        && isValidId(taskId)
        && isValidTask(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'status', 'dueDate', 'isCompleted', 'updatedAt']);

      // Secure deletion
      allow delete: if isSignedIn()
        && isValidId(taskId)
        && existing().userId == request.auth.uid;
    }

    // User profile isolation
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      
      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'theme', 'updatedAt']);

      allow delete: if false;
    }
  }
}
